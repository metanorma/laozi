/* Page Definitions */
@page {
  mso-page-border-surround-header: no;
  mso-page-border-surround-footer: no;
  mso-footnote-separator: url(cid:header.html) fs;
  mso-footnote-continuation-separator: url(cid:header.html) fcs;
  mso-endnote-separator: url(cid:header.html) es;
  mso-endnote-continuation-separator: url(cid:header.html) ecs;
  mso-facing-pages: yes; }

@page WordSection1 {
  size: 21.0cm 842.0pt;
  margin: 82.2pt 62.35pt 79.4pt 62.35pt;
  mso-header-margin: 45.35pt;
  mso-footer-margin: 2.0cm;
  mso-even-header: url(cid:header.html) eh1;
  mso-header: url(cid:header.html) h1;
  mso-even-footer: url(cid:header.html) ef1;
  mso-footer: url(cid:header.html) f1;
  mso-first-header: url(cid:header.html) fh1;
  mso-first-footer: url(cid:header.html) ff1;
  mso-paper-source: 0;
  layout-grid: 17.0pt 0pt;
  mso-layout-grid-char-alt: 56; }

div.WordSection1 {
  page: WordSection1; }

